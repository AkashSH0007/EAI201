# --- Step 10: Calculate Historical Win Rate ---
print("\n--- Calculating Historical Win Rate ---")

# Ensure DataFrame is sorted by date for correct historical calculation
world_cup_merged_df = world_cup_merged_df.sort_values(by='date')

# Dictionary to cache results for efficiency
win_rate_cache = {}

def calculate_win_rate(team, date, df):
    """Calculates the win rate for a team in WC matches before a given date."""
    cache_key = (team, date)
    if cache_key in win_rate_cache:
        return win_rate_cache[cache_key]

    # Filter matches *before* the given date where the team played
    past_matches = df[(df['date'] < date) & ((df['home_team'] == team) | (df['away_team'] == team))]

    if past_matches.empty:
        
        win_rate_cache[cache_key] = 0.0
        return 0.0

    wins = 0
    # Check home wins
    wins += len(past_matches[(past_matches['home_team'] == team) & (past_matches['home_score'] > past_matches['away_score'])])
    # Check away wins
    wins += len(past_matches[(past_matches['away_team'] == team) & (past_matches['away_score'] > past_matches['home_score'])])

    total_matches = len(past_matches)
    win_rate = wins / total_matches if total_matches > 0 else 0.0

    win_rate_cache[cache_key] = win_rate
    return win_rate

# Apply the function to calculate win rates - This might take a minute or two
print("Calculating win rates (this may take some time)...")
world_cup_merged_df['home_team_win_rate'] = world_cup_merged_df.apply(
    lambda row: calculate_win_rate(row['home_team'], row['date'], world_cup_merged_df),
    axis=1
)
world_cup_merged_df['away_team_win_rate'] = world_cup_merged_df.apply(
    lambda row: calculate_win_rate(row['away_team'], row['date'], world_cup_merged_df),
    axis=1
)
print("SUCCESS: Historical win rates calculated.")

