print("\n--- Creating Target Variable (Match Outcome) ---")

# Define match outcome: 1 = home win, 0 = draw, 2 = away win
def get_outcome(row):
    if row['home_score'] > row['away_score']:
        return 1 # Home win
    elif row['home_score'] < row['away_score']:
        return 2 # Away win
    else:
        return 0 # Draw

world_cup_merged_df['match_outcome'] = world_cup_merged_df.apply(get_outcome, axis=1)

print("SUCCESS: 'match_outcome' column created (1=HomeWin, 0=Draw, 2=AwayWin).")
print(world_cup_merged_df[['date', 'home_team', 'away_team', 'home_score', 'away_score', 'match_outcome']].head())

