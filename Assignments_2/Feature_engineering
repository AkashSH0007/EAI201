import pandas as pd
from datetime import datetime

results_file = 'results.csv'
players_file = 'players.csv'
valuations_file = 'player_valuations.csv'
appearances_file = 'appearances.csv'

try:
    print(f"Loading {results_file}...")
    match_df = pd.read_csv(results_file)
    print(f"Loading {players_file}...")
    players_df = pd.read_csv(players_file)
    print(f"Loading {valuations_file}...")
    valuations_df = pd.read_csv(valuations_file)
    print(f"Loading {appearances_file}...")
    appearances_df = pd.read_csv(appearances_file, usecols=['player_id', 'minutes_played'])
    print("Files loaded successfully!")
except FileNotFoundError as e:
    print(f"\nERROR: {e}. Make sure CSV files are in the same folder.")
    exit() 
except Exception as e:
    print(f"\nAn unexpected error occurred during loading: {e}")
    exit()

#  Clean Historical Match Data 
print("\n--- Cleaning Historical Match Data ---")
try:
    match_df['date'] = pd.to_datetime(match_df['date'])
    world_cup_df = match_df[match_df['tournament'] == 'FIFA World Cup'].copy()
    print(f"SUCCESS: Historical data cleaned! Found {len(world_cup_df)} World Cup matches.")
except Exception as e:
    print(f"ERROR cleaning match data: {e}")
    exit()

# --- Step 2: Clean Player Data & Calculate Age ---
print("\n--- Cleaning Player Data & Calculating Age ---")
try:
    players_df['date_of_birth'] = pd.to_datetime(players_df['date_of_birth'], errors='coerce')
    reference_date = datetime.now()
    players_df['age'] = players_df['date_of_birth'].apply(
        lambda dob: (reference_date - dob).days // 365 if pd.notnull(dob) else None
    )
    players_cleaned_df = players_df[[
        'player_id', 'name', 'country_of_citizenship', 'date_of_birth', 'age', 'position', 'sub_position'
    ]].copy()
    players_cleaned_df.dropna(subset=['age'], inplace=True)
    players_cleaned_df['age'] = players_cleaned_df['age'].astype(int)
    print("SUCCESS: Player data cleaned and age calculated!")
except Exception as e:
    print(f"ERROR cleaning player data: {e}")
    exit()

# --- Step 3: Get Latest Market Value ---
print("\n--- Processing Market Valuations ---")
try:
    valuations_df['date'] = pd.to_datetime(valuations_df['date'], errors='coerce')
    valuations_df.dropna(subset=['date', 'market_value_in_eur', 'player_id'], inplace=True)
    latest_valuations = valuations_df.sort_values(by='date').drop_duplicates(subset=['player_id'], keep='last')
    latest_valuations = latest_valuations[['player_id', 'market_value_in_eur']]
    players_cleaned_df = pd.merge(players_cleaned_df, latest_valuations, on='player_id', how='left')
    print("SUCCESS: Latest market value merged!")
except Exception as e:
    print(f"ERROR processing valuations: {e}")
    exit()

# --- Step 4: Calculate Total Minutes Played (Experience) ---
print("\n--- Calculating Player Experience (Total Minutes Played) ---")
try:
    appearances_df.dropna(subset=['player_id', 'minutes_played'], inplace=True)
    player_experience = appearances_df.groupby('player_id')['minutes_played'].sum().reset_index()
    player_experience.rename(columns={'minutes_played': 'total_minutes_played'}, inplace=True)
    players_cleaned_df = pd.merge(players_cleaned_df, player_experience, on='player_id', how='left')
    
    players_cleaned_df['total_minutes_played'] = players_cleaned_df['total_minutes_played'].fillna(0)
    players_cleaned_df['total_minutes_played'] = players_cleaned_df['total_minutes_played'].astype(int)
    print("SUCCESS: Player experience calculated and merged!")
except Exception as e:
    print(f"ERROR processing appearances: {e}")
    exit()

# Step 5: Aggregate Player Data to Team Level 
print("\n--- Aggregating Player Features to Team Level ---")
try:
    # Fill missing market values with 0
    players_cleaned_df['market_value_in_eur'] = players_cleaned_df['market_value_in_eur'].fillna(0)

    # Group by country and calculate aggregate stats
    team_features = players_cleaned_df.groupby('country_of_citizenship').agg(
        team_avg_age=('age', 'mean'),
        team_total_market_value=('market_value_in_eur', 'sum'),
        team_avg_experience=('total_minutes_played', 'mean') # Using mean minutes as experience metric
    ).reset_index()

    team_features.rename(columns={'country_of_citizenship': 'team'}, inplace=True)
    team_features['team_avg_age'] = round(team_features['team_avg_age'], 2)
    team_features['team_avg_experience'] = round(team_features['team_avg_experience'], 2)
    print("SUCCESS: Team-level features calculated!")
    
except Exception as e:
    print(f"ERROR aggregating team features: {e}")
    exit()

# --- Step 6: Merge Team Features into World Cup Data ---
print("\n--- Merging Team Features into World Cup Match Data ---")
try:
    # Merge for home teams
    world_cup_merged_df = pd.merge(
        world_cup_df,
        team_features,
        left_on='home_team',
        right_on='team',
        how='left'
    )
    world_cup_merged_df.rename(columns={
        'team_avg_age': 'home_team_avg_age',
        'team_total_market_value': 'home_team_total_market_value',
        'team_avg_experience': 'home_team_avg_experience'
    }, inplace=True)
    world_cup_merged_df.drop(columns=['team'], inplace=True)

    # Merge for away teams
    world_cup_merged_df = pd.merge(
        world_cup_merged_df,
        team_features,
        left_on='away_team',
        right_on='team',
        how='left'
    )
    world_cup_merged_df.rename(columns={
        'team_avg_age': 'away_team_avg_age',
        'team_total_market_value': 'away_team_total_market_value',
        'team_avg_experience': 'away_team_avg_experience'
    }, inplace=True)
    world_cup_merged_df.drop(columns=['team'], inplace=True)
    print("SUCCESS: Team features merged for home and away teams!")

except Exception as e:
    print(f"ERROR merging team features into match data: {e}")
    exit()

# --- Step 7: Handle Missing Team Features using Imputation ---
print("\n--- Handling Missing Team Features ---")
try:
    # Calculate medians for imputation
    median_home_age = world_cup_merged_df['home_team_avg_age'].median()
    median_home_value = world_cup_merged_df['home_team_total_market_value'].median()
    median_home_exp = world_cup_merged_df['home_team_avg_experience'].median()
    median_away_age = world_cup_merged_df['away_team_avg_age'].median()
    median_away_value = world_cup_merged_df['away_team_total_market_value'].median()
    median_away_exp = world_cup_merged_df['away_team_avg_experience'].median()

    # Impute missing values using fillna
    world_cup_merged_df['home_team_avg_age'].fillna(median_home_age, inplace=True)
    world_cup_merged_df['home_team_total_market_value'].fillna(median_home_value, inplace=True)
    world_cup_merged_df['home_team_avg_experience'].fillna(median_home_exp, inplace=True)
    world_cup_merged_df['away_team_avg_age'].fillna(median_away_age, inplace=True)
    world_cup_merged_df['away_team_total_market_value'].fillna(median_away_value, inplace=True)
    world_cup_merged_df['away_team_avg_experience'].fillna(median_away_exp, inplace=True)
    print("SUCCESS: Missing team features imputed using median values.")
    
    # Verify imputation
    print("\nMissing values after imputation:")
    print(world_cup_merged_df[['home_team_avg_age', 'home_team_total_market_value', 'home_team_avg_experience',
                               'away_team_avg_age', 'away_team_total_market_value', 'away_team_avg_experience']].isnull().sum())
except Exception as e:
    print(f"ERROR during imputation: {e}")
    exit()

# --- Step 8: Engineer Goal Difference ---
print("\n--- Engineering Goal Difference ---")
try:
    world_cup_merged_df['goal_difference'] = world_cup_merged_df['home_score'] - world_cup_merged_df['away_score']
    print("SUCCESS: Goal difference feature created.")
    
except Exception as e:
    print(f"ERROR creating goal difference: {e}")
    exit()

# --- Display Final Preview and Save ---
print("\n--- Final Data Preview (End of Current Steps) ---")
print(world_cup_merged_df.head())
print("\nFinal data info:")
world_cup_merged_df.info()

# Save the current state to a CSV
output_filename = 'world_cup_matches_with_features_partial.csv'
